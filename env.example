# ═══════════════════════════════════════════════════════════
# DOMAIN SELECTION
# ═══════════════════════════════════════════════════════════
TENANT_DOMAIN=valentine          # ✅ valentine ready | others need KB+prompts first
TENANT_ID=reviv_bali             # Unique tenant ID within domain

GEMINI_API_KEY=key
WHATSAPP_TOKEN=null

# ═══════════════════════════════════════════════════════════
# DOMAIN-SPECIFIC OVERRIDES
# ═══════════════════════════════════════════════════════════
SAFE_MODE_PHONE=+6281234567890   # Phone shown in safe-mode message
ALERT_WEBHOOK_URL=https://...    # Slack / WA relay for escalations

# BaliDrink only (when KB ready)
MIN_AGE_VERIFICATION=21          # Age check required

# E-Bike only (when KB ready)
SHOP_LOCATION=Canggu             # Default pickup location

REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════
# WHA (WhatsApp HTTP API) CONFIG
# ═══════════════════════════════════════════════════════════
WHA_BASE_URL=https://waha.your-project.com     # WHA server URL for sending messages
WHA_SESSION=session-name                     # WHA session name
WAHA_API_KEY=apikey
ALERT_PHONE_NUMBER=phone1,phone2

# ═══════════════════════════════════════════════════════════
# DATABASE CONFIG (PostgreSQL)
# ═══════════════════════════════════════════════════════════
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

AGENT_CACHE_NAME=valentine_cache